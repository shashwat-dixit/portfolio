# ── Database (self-hosted PostgreSQL in Docker) ──────────────────────────────
POSTGRES_PASSWORD=change-me-strong-password

# ── Redis (self-hosted in Docker) ────────────────────────────────────────────
REDIS_PASSWORD=change-me-strong-password

# ── GitLab blog source ───────────────────────────────────────────────────────
GITLAB_REPO=https://gitlab.com/shashwat-dixit/blog.git
GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx

# ── Protect the sync endpoint ────────────────────────────────────────────────
SYNC_API_KEY=generate-a-strong-random-string

# ── Cross-post (optional — skipped when unset) ───────────────────────────────
# Medium: Settings → Security and apps → Integration tokens (existing tokens still work).
# MEDIUM_TOKEN=
# MEDIUM_PUBLICATION_ID=
# MEDIUM_PUBLISH_STATUS=public

# Substack: DevTools → Application → Cookies → substack.sid on substack.com
# SUBSTACK_PUBLICATION_URL=https://yourname.substack.com
# SUBSTACK_SID=
# SUBSTACK_CONNECT_SID=
# SUBSTACK_COOKIES=
# SUBSTACK_PUBLISH=false

# ── Frontend (baked into Docker image at build time) ─────────────────────────
# PUBLIC_API_URL=https://api.shashwatdixit.com
# PUBLIC_POSTHOG_KEY=phc_your_posthog_project_api_key
# PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
